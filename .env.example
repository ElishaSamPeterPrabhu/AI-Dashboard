# Optional: absolute API origin (default: same origin + Vite /api proxy)
# VITE_API_BASE=http://localhost:3000

# ── Live Agent + Canvas Demo (/demo) ───────────────────────────────────────
# Create an "AI Planner" agent in Trimble AI Studio (https://studio.ai.trimble.com):
#   • System prompt + MCP tools as described in the live-demo plan
#   • Grant app access: applications:61abccab-10ea-47bf-a616-b1b9c48bfa7b (Viewer)
#   • Paste the agent UUID here for the Assist embed:
# VITE_PLANNER_AGENT_ID=<your-studio-agent-id>
#
# Trimble ID (PKCE) for /demo: register redirect URI for client
# 61abccab-10ea-47bf-a616-b1b9c48bfa7b, e.g.
#   http://localhost:5173/tid-callback.html
# (same pattern as modus-wc-2.0 Storybook ChatPanel auth.)
#
# Studio MCP tool discovery against a *local* BFF: expose port 3000, e.g.
#   ngrok http 3000
# then register the MCP HTTP tool URL as:
#   https://<your-subdomain>.ngrok-free.app/api/planner/mcp
# (The demo UI intercepts tool calls via onBeforeRun → same-origin MCP anyway;
#  ngrok is only needed so Studio can list tools when configuring the agent.)

# Live agents: POST /api/agents/:id/runs (BFF reads TRIMBLE_* from server/.env only).
#   "true"  → always use live when the AI node has agentId.
#   "false" → always mock.
#   (omit)  → use live if GET /api/health reports agentKeySet (after app loads projects from API).
# VITE_LIVE_AGENTS=true
