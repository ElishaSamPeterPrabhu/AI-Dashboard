{
  "name": "ai-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run start:dev -w ai-dashboard-server",
    "dev:all": "concurrently -n ui,api -c blue,green \"npm run dev\" \"npm run dev:server\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:ai": "node scripts/test-ai-bff.mjs",
    "test:planner": "node scripts/test-planner-mcp.mjs",
    "bundle:eb": "bash scripts/bundle-eb.sh"
  },
  "dependencies": {
    "@trimble-oss/modus-icons": "1.21.0",
    "@trimble-oss/moduswebcomponents": "1.2.0",
    "@trimble-oss/moduswebcomponents-react": "1.2.0-react19",
    "@xyflow/react": "^12.3.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.0",
    "recharts": "^2.15.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.1"
  }
}
