    {
      "parameters": {
        "jsCode": "/**\n * Get Connect Component Details - n8n Code Node\n * \n * Extracts specific component data from the loaded mapping JSON\n * \n * n8n usage:\n *   - $input.first().json.comp_data: The component name to extract (e.g., \"Button\")\n *   - $('Get Component Mapping Data').first().json.value: The entire mapping JSON (already parsed object)\n * \n * Returns: The specific component's data\n */\n\n// Get the component name from input\nconst componentName = $('Get Component Mapping Data').first().json.value;\n\n// Get the mapping data from previous node\n// It should already be a parsed object, not a string\nconst mappingData = $input.first().json.comp_data;\n\n// If mappingData is a string, parse it\nconst data = typeof mappingData === 'string' ? JSON.parse(mappingData) : mappingData;\n\n// Extract and return that component's data\nif (data && data.hasOwnProperty(componentName)) {\n  return data[componentName];\n} else {\n  return {\n    error: `Component '${componentName}' not found`,\n    componentName: componentName,\n    mappingDataType: typeof data,\n    hint: \"Check if mapping data is loaded correctly\"\n  };\n}\n"
      },
      "type": "n8n-nodes-base.code",
