# OAuth proxy for MCP server OAuth 2.1 flow
# dev:   https://id-mcp.dev.trimble-transportation.com
# stage: https://id-mcp.staging.trimble-transportation.com
# prod:  https://id-mcp.trimble-transportation.com
OAUTH_SERVER_URL=https://id-mcp.dev.trimble-transportation.com

# Token issuer — the JWT's "iss" claim (id.trimble.com for prod, stage.id.trimblecloud.com for stage)
TOKEN_ISSUER_URL=https://id.trimble.com

# TID OAuth app credentials (for machine token refresh + E2E tests)
CLIENT_ID=
CLIENT_SECRET=

# OAuth scope your TID app is allowed to request (TID app name)
E2E_OAUTH_SCOPE=

# JWT audience(s) — comma-separated
# Trimble Agent Service audience (stage): 13b1bf43-8ac8-49e5-8df6-535cc6d885b3
# Trimble Agent Service audience (prod):  1c5cf54b-928a-4d78-a9f4-fd44a7cb8ddc
JWT_AUDIENCE=1c5cf54b-928a-4d78-a9f4-fd44a7cb8ddc

# This server's own URL (used for metadata)
RESOURCE_SERVER_URL=http://localhost:4000

# Server identity
SERVER_NAME=ai-dashboard-mcp

# Trimble Agent Service
TRIMBLE_AGENT_BASE_URL=https://agents.ai.trimble.com
DEMO_PLANNER_AGENT_ID=df7b36b9-328a-41a5-8cd8-73d80c37ac46
WORKFLOW_BUILDER_AGENT_ID=61cbe03d-2d75-47af-89b5-bf9bb455f905

# Amplify canvas UI (for MCP App iframe)
# https://feature-mcp-apps-canvas.d144x4qv8kv4uy.amplifyapp.com
UI_PUBLIC_URL=

# Environment
ENV=development
