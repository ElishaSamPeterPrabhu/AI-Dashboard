PORT=3000

# ── Public URLs (production — AWS Elastic Beanstalk + Amplify) ───────────────
# BFF HTTPS URL — MCP endpoint is {BFF_PUBLIC_URL}/mcp
# BFF_PUBLIC_URL=https://ai-dashboard-prod.us-east-1.elasticbeanstalk.com

# React UI — used by the MCP App iframe (Amplify Hosting URL)
# In dev defaults to http://localhost:5173
# UI_PUBLIC_URL=https://main.d1234abcd.amplifyapp.com

# ── Trimble Agent Service ────────────────────────────────────────────────────
# Base URL of the Trimble Agent Service API (without trailing slash).
# When unset, the BFF falls back to the built-in mock so the canvas still works.
#
# Trimble AI Studio is at: https://studio.ai.trimble.com
# Agent API docs:          https://developer.ai.trimble.com/docs/capabilities/agents
#
TRIMBLE_AGENT_BASE_URL=https://agents.ai.trimble.com

# Bearer token issued by TID OAuth 2.0 (PKCE flow). Once the auth module is
# wired this will come from the httpOnly session instead of an env var.
# Also used by GET /api/auth/token-for-ui when embedding Assist from the UI.
TRIMBLE_AGENT_API_KEY=

# ── /demo direct agent loop (POST /api/demo/run) ─────────────────────────────
# UUID of the Studio agent the BFF calls at .../v1/agents/{id}/runs (required on
# the *server* — VITE_PLANNER_AGENT_ID in the UI is NOT used for this path).
# TRIMBLE_AGENT_API_KEY must be allowed to *run* that agent (Studio ACL / app grant).
# DEMO_PLANNER_AGENT_ID=df7b36b9-328a-41a5-8cd8-73d80c37ac46

# ── Workflow Builder sub-agent ────────────────────────────────────────────────
# UUID of a dedicated Studio agent whose system prompt is server/WorkflowBuilderPrompt.md.
# When set, the orchestrator (above) can emit type:"workflow_spec" and the BFF
# delegates canvas construction to this specialist agent.
# When unset, workflow_spec responses return an error asking you to configure it.
# WORKFLOW_BUILDER_AGENT_ID=
